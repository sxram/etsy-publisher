{
  "name": "giggle-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "etsy:connect": "node --env-file-if-exists=.env --import tsx scripts/etsy-connect.ts",
    "gelato:preview": "node --env-file-if-exists=.env --import tsx src/gelato-folder.ts preview",
    "gelato:create": "node --env-file-if-exists=.env --import tsx src/gelato-folder.ts create",
    "gelato:resume": "node --env-file-if-exists=.env --import tsx src/gelato-folder.ts resume",
    "dropbox:connect": "node --env-file-if-exists=.env --import tsx src/dropbox-storage.ts",
    "gelato:mockups": "node --env-file-if-exists=.env --import tsx src/color-mockups.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
