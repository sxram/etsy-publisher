# Kopiere diese Datei nach .env und ergänze deine eigenen Werte.
# Bestehende .env nicht überschreiben. Keine echten Schlüssel weitergeben.

# --- Gelato: für gelato:create und gelato:resume erforderlich ---
# API-Key aus dem Gelato-Dashboard.
GELATO_API_KEY=
# ID des verbundenen Stores; für Etsy den Etsy-Store in Gelato verwenden.
GELATO_STORE_ID=
# ID einer gespeicherten T-Shirt-Vorlage mit Bildplatzhalter ImageFront.
# Größen, Farben, Preise und Mockups werden in der Vorlage festgelegt.
GELATO_TEMPLATE_TSHIRT=

# --- Bildspeicher: für gelato:create erforderlich ---
# Gelato muss das Bild herunterladen können. Das Script lädt es automatisch
# in einen privaten S3-kompatiblen Bucket und erstellt eine signierte URL.
# Einen Bucket und passende Zugangsdaten musst du einmalig einrichten.
#
# Cloudflare R2:
# GELATO_S3_ENDPOINT=https://DEINE_ACCOUNT_ID.r2.cloudflarestorage.com
# GELATO_S3_REGION=auto
#
# AWS S3 (Beispiel Frankfurt):
# GELATO_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# GELATO_S3_REGION=eu-central-1
GELATO_S3_ENDPOINT=
GELATO_S3_REGION=auto
GELATO_S3_BUCKET=
GELATO_S3_ACCESS_KEY_ID=
GELATO_S3_SECRET_ACCESS_KEY=
# Nur bei temporären AWS-Zugangsdaten ausfüllen, sonst leer lassen.
GELATO_S3_SESSION_TOKEN=

# --- Lokaler MCP-Server: Standardwerte können bleiben ---
# Für die Gelato-Kommandozeilenbefehle wird kein laufender Server benötigt.
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274

# --- Direkter Etsy-Zugang: optional ---
# Für den Etsy-Entwurf über einen in Gelato verbundenen Store nicht nötig.
# Nur aktivieren, wenn du zusätzlich die direkten Etsy-MCP-Tools verwendest.
ETSY_ENABLED=false
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
# Exakte HTTPS-Callback-Adresse aus deiner Etsy-App-Konfiguration.
ETSY_REDIRECT_URI=
ETSY_TOKEN_FILE=.private/etsy-tokens.json

# Bildspeicher auswählen: s3 oder dropbox.
GELATO_STORAGE_PROVIDER=dropbox
# App key aus der Dropbox App Console (App folder / Scoped access).
# Kein App secret erforderlich: die Terminal-Anmeldung verwendet PKCE.
DROPBOX_APP_KEY=
DROPBOX_TOKEN_FILE=.private/dropbox-tokens.json

# Automatische Etsy-Versandprüfung nach Gelato-Übertragung (Pflichtschritt).
# Nutzt die eigene .env und OAuth-Anmeldung des Etsy-Script-Projekts.
# Dort einmal shops_w freigeben; bei Fehlern gelato:resume erneut ausführen.
ETSY_SHIPPING_SCRIPT=
